rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /familias/{familyId}/criancas/{childId}/tarefas/{taskId}/{fileName} {
      // Downloads happen through the authenticated parent-only Cloud Function.
      // Do not expose file data or metadata through the client Storage SDK.
      allow read: if false;
      allow create, update: if request.auth != null
        && request.auth.token.familyId == familyId
        && request.auth.token.familyRole in ['parent', 'child']
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp)')
        && fileName.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(_[0-9a-zA-Z-]+)?\\.(jpg|jpeg|webp)$');
      allow delete: if request.auth != null
        && request.auth.token.familyId == familyId
        && request.auth.token.familyRole == 'parent';
    }
  }
}